[Unit]
Description=KM Help Desk Scheduler
After=network.target redis.service mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/km-help-desk
ExecStart=/bin/bash -c "while true; do php /var/www/km-help-desk/artisan schedule:run --verbose --no-interaction; sleep 60; done"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
